{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/relationship_conditioned_human_decision_policy.schema.json",
  "title": "Relationship-Conditioned Human Decision Policy Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "decision_id",
    "relationship",
    "authority",
    "human_impact",
    "uncertainty",
    "temporal_identity",
    "alternatives_considered",
    "requested_operation",
    "decision",
    "reasons",
    "traceability"
  ],
  "properties": {
    "policy_version": {"const": "1.0.0"},
    "decision_id": {"type": "string", "minLength": 1},
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "history_available", "history_used_as_context_only"],
      "properties": {
        "role": {"enum": ["advisor", "witness", "guardian", "delegate", "counterparty"]},
        "history_available": {"type": "boolean"},
        "history_used_as_context_only": {"const": true},
        "typicality": {"enum": ["typical", "atypical", "unknown"]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source", "scope", "revocable"],
      "properties": {
        "state": {"enum": ["valid", "missing", "expired", "revoked", "conflicting", "out_of_scope"]},
        "source": {"type": ["string", "null"]},
        "scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "revocable": {"type": "boolean"}
      }
    },
    "human_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "irreversible", "self_sacrificial", "severe_harm_possible"],
      "properties": {
        "class": {"enum": ["reversible", "serious", "irreversible", "self_sacrificial"]},
        "irreversible": {"type": "boolean"},
        "self_sacrificial": {"type": "boolean"},
        "severe_harm_possible": {"type": "boolean"}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_world_acknowledged", "future_frameworks_unknown", "future_interpreters_unknown", "acknowledgment_is_not_authorization"],
      "properties": {
        "open_world_acknowledged": {"type": "boolean"},
        "future_frameworks_unknown": {"type": "boolean"},
        "future_interpreters_unknown": {"type": "boolean"},
        "acknowledgment_is_not_authorization": {"const": true}
      }
    },
    "temporal_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["future_self_divergence_considered", "present_consent_treated_as_non_final"],
      "properties": {
        "future_self_divergence_considered": {"type": "boolean"},
        "present_consent_treated_as_non_final": {"const": true}
      }
    },
    "alternatives_considered": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "requested_operation": {"enum": ["advice", "witness", "delay", "referral", "execute_reversible", "execute_irreversible"]},
    "decision": {"enum": ["ADVISE", "WITNESS_ONLY", "PROTECTIVE_DELAY", "EXECUTE_REVERSIBLE", "NEGOTIATE", "DECLINE", "ESCALATE", "ABSTAIN", "FAIL_CLOSED"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_required", "integrity_protected"],
      "properties": {
        "record_required": {"const": true},
        "integrity_protected": {"type": "boolean"},
        "receipt_ref": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authority": {"properties": {"state": {"not": {"const": "valid"}}}}
        }
      },
      "then": {
        "properties": {
          "decision": {"enum": ["ESCALATE", "ABSTAIN", "FAIL_CLOSED"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "requested_operation": {"const": "execute_irreversible"}
        }
      },
      "then": {
        "properties": {
          "decision": {"enum": ["PROTECTIVE_DELAY", "ESCALATE", "ABSTAIN", "FAIL_CLOSED"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "human_impact": {
            "properties": {
              "severe_harm_possible": {"const": true},
              "irreversible": {"const": true}
            },
            "required": ["severe_harm_possible", "irreversible"]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {"enum": ["PROTECTIVE_DELAY", "ESCALATE", "ABSTAIN", "FAIL_CLOSED"]}
        }
      }
    }
  ]
}
