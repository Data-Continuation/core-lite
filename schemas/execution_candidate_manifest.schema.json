{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/execution_candidate_manifest.schema.json",
  "title": "Execution Candidate Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "action",
    "live_state",
    "authority",
    "effects",
    "denial",
    "trajectory",
    "recoverability",
    "traceability",
    "declared_decision"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "class", "reversible", "severe_human_harm_possible", "sandbox_only"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "class": {"enum": ["report", "notification", "configuration", "simulation", "other"]},
        "reversible": {"type": "boolean"},
        "severe_human_harm_possible": {"type": "boolean"},
        "sandbox_only": {"const": true}
      }
    },
    "live_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "age_seconds", "max_age_seconds", "sufficient"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "age_seconds": {"type": "integer", "minimum": 0},
        "max_age_seconds": {"type": "integer", "minimum": 0},
        "sufficient": {"type": "boolean"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source_refs", "scope", "rederived_at_commit"],
      "properties": {
        "state": {"enum": ["valid", "missing", "expired", "revoked", "conflicting", "out_of_scope"]},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rederived_at_commit": {"type": "boolean"}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicted_domains", "authorized_domains", "collateral_resolved"],
      "properties": {
        "predicted_domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "authorized_domains": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "collateral_resolved": {"type": "boolean"}
      }
    },
    "denial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reachable", "mechanisms"],
      "properties": {
        "reachable": {"type": "boolean"},
        "mechanisms": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_id", "governability_preserved"],
      "properties": {
        "sequence_id": {"type": "string", "minLength": 1},
        "governability_preserved": {"type": "boolean"}
      }
    },
    "recoverability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserved", "rollback_ref"],
      "properties": {
        "preserved": {"type": "boolean"},
        "rollback_ref": {"type": ["string", "null"]}
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_required", "integrity_protected", "receipt_ref"],
      "properties": {
        "record_required": {"const": true},
        "integrity_protected": {"type": "boolean"},
        "receipt_ref": {"type": ["string", "null"]}
      }
    },
    "declared_decision": {"enum": ["ALLOW", "DENY", "ABSTAIN", "ESCALATE"]}
  }
}
