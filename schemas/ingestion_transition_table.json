{
  "schema": "stegverse_ingestion_transition_table.v1",
  "table_id": "core-lite-ingestion-transition-table",
  "version": "0.9.0",
  "canonical_claim": "Ingestion is not file transfer. Ingestion is a governed transition sequence where every artifact, action, outcome, and generated artifact must remain hash-linked, authority-matched, locally recorded, and upward-reconcilable.",
  "outcomes": [
    "ALLOW",
    "FAIL_CLOSED",
    "QUARANTINE",
    "SUPERSEDE",
    "INSTALL",
    "PARTIAL_INSTALL",
    "ROLLBACK",
    "FORWARD_REPAIR",
    "PROMOTE_TO_CANONICAL",
    "REVOKE",
    "INVALIDATE",
    "REMEDIATE",
    "FORK_DETECTED",
    "HASH_MISMATCH",
    "AUTHORITY_ESCALATION_REJECTED",
    "STALE_PENDING",
    "RETRY",
    "ESCALATE",
    "ROUTE_NATIVE",
    "ROUTE_PEER",
    "ROUTE_REPO_ONLY",
    "ROUTE_REJECTED",
    "CONFIRM_UPSTREAM",
    "DEFER_CONFIRMATION"
  ],
  "transition_classes": [
    {
      "transition_id": "INGEST-ENTRY-USER-001",
      "transition_name": "user_or_generated_artifact_entry",
      "family": "external_entry",
      "entrypoint_class": "user_entrypoint_and_master_records_endpoint",
      "required_fields": [
        "bundle_hash",
        "manifest_hash",
        "origin",
        "destination"
      ],
      "parent_event_hash_required": false,
      "allowed_outcomes": [
        "ALLOW",
        "QUARANTINE",
        "FAIL_CLOSED"
      ]
    },
    {
      "transition_id": "INGEST-ENTRY-MASTER-001",
      "transition_name": "master_records_chain_continuation",
      "family": "master_records_entry",
      "entrypoint_class": "master_records_endpoint_only",
      "required_fields": [
        "event_hash",
        "parent_event_hash",
        "bundle_hash",
        "manifest_hash"
      ],
      "parent_event_hash_required": true,
      "allowed_outcomes": [
        "ALLOW",
        "QUARANTINE",
        "FAIL_CLOSED"
      ]
    },
    {
      "transition_id": "INGEST-QUEUE-PLAN-001",
      "transition_name": "incoming_queue_planning",
      "family": "queue",
      "required_fields": [
        "priority",
        "bundle_version",
        "succession"
      ],
      "allowed_outcomes": [
        "ALLOW",
        "SUPERSEDE",
        "FAIL_CLOSED"
      ]
    },
    {
      "transition_id": "INGEST-INSTALL-001",
      "transition_name": "declared_file_install",
      "family": "installation",
      "required_fields": [
        "event_hash",
        "manifest_hash",
        "declared_files",
        "install_policy"
      ],
      "allowed_outcomes": [
        "INSTALL",
        "PARTIAL_INSTALL",
        "FAIL_CLOSED"
      ]
    },
    {
      "transition_id": "INGEST-CONFIRM-001",
      "transition_name": "outcome_confirmation_upstream",
      "family": "confirmation",
      "required_fields": [
        "event_hash",
        "parent_event_hash",
        "outcome",
        "receipt_hash"
      ],
      "allowed_outcomes": [
        "CONFIRM_UPSTREAM",
        "DEFER_CONFIRMATION",
        "STALE_PENDING",
        "ESCALATE"
      ]
    }
  ]
}
