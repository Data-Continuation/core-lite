{
  "name": "core-lite-one-upload-package-v001",
  "purpose": "Single downloadable package containing the root-staged bootstrap workflow, bootstrap manifest, and clean core-lite repo upload zip.",
  "upload_contents_to_repo_root": [
    "run.yml",
    "core-lite-bootstrap-manifest-v001.json",
    "core-lite-clean-repo-upload-v001.zip"
  ],
  "move_or_recreate_workflow": {
    "from_root": "run.yml",
    "to_actual_required_path": ".github/workflows/run.yml",
    "display_path_without_leading_dot": "github/workflows/run.yml"
  },
  "bundle_to_extract": "core-lite-clean-repo-upload-v001.zip",
  "bundle_sha256": "a9b455cb197ede09a8ac1ae929126876c82e90aab905d7c7d9ac7a1843951405",
  "workflow_name": "Install core-lite bundle",
  "trigger": "workflow_dispatch only",
  "done_when": [
    "src/core_lite/ exists",
    "examples/ exists",
    "tests/ exists",
    ".github/workflows/test.yml exists",
    "the core-lite-test workflow runs successfully"
  ],
  "note": "A root-level run.yml is only a staging file. GitHub Actions recognizes it only after it is moved or recreated at .github/workflows/run.yml."
}