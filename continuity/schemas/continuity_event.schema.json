{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/continuity_event.schema.json",
  "title": "Continuity Event",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "event_type",
    "source_path",
    "source_sha256",
    "created_at_utc",
    "actor",
    "disposition",
    "evidence_ref"
  ],
  "properties": {
    "schema": { "const": "stegverse.continuity_event.v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "minLength": 1 },
    "source_path": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "minLength": 1 },
    "disposition": { "type": "string", "enum": ["observed", "accepted_for_review", "incomplete", "isolated"] },
    "evidence_ref": { "type": "string", "minLength": 1 },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
