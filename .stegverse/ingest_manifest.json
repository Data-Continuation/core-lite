{
  "schema": "stegverse_ingest_manifest.v1",
  "bundle_id": "core-lite-v0.8.1-wire-source-state-index",
  "bundle_version": "0.8.1",
  "target_repo": "Data-Continuation/core-lite",
  "priority": "Critical",
  "bundle_family": "core-lite",
  "succession": {
    "mode": "versioning",
    "family": "core-lite"
  },
  "entrypoint": {
    "class": "master_records_endpoint_only",
    "source": "org_core_lite",
    "parent_event_hash": "sha256:bootstrap-local-core-lite-upgrade",
    "authority_confirmation": "local_core_lite_upgrade"
  },
  "requested_allow_scopes": [
    "ALLOW_QUEUE",
    "ALLOW_INSTALL"
  ],
  "purpose": "Wire source state index generation into the Core-Lite CLI run path.",
  "install_policy": {
    "default_action": "overwrite_declared_files_only",
    "preserve_runtime_artifacts": true,
    "preserve_unlisted_files": true,
    "fail_on_unclassified_files": true
  },
  "files": [
    {
      "path": "core_lite/cli.py",
      "class": "source",
      "action": "overwrite"
    },
    {
      "path": "docs/core-lite-v0.8.1-wire-source-state-index.md",
      "class": "documentation",
      "action": "overwrite"
    },
    {
      "path": "iosnoperiod.md",
      "class": "documentation",
      "action": "overwrite"
    },
    {
      "path": ".stegverse/ingest_manifest.json",
      "class": "ingest_manifest",
      "action": "read_before_install"
    },
    {
      "path": "iosnoperiod/stegverse/ingest_manifest.json",
      "class": "iosnoperiod_mirror",
      "action": "overwrite"
    }
  ],
  "iosnoperiod_mappings": [
    {
      "canonical_path": ".stegverse/ingest_manifest.json",
      "iosnoperiod_path": "iosnoperiod/stegverse/ingest_manifest.json"
    }
  ],
  "generated_outputs": [
    ".stegverse/source_state_index.json",
    "core_lite_run_summary.json",
    ".stegverse/receipts/core_lite_receipts.jsonl"
  ],
  "done_criteria": [
    "cli.py imports generate_source_state_index.",
    "cli.py writes source_state_index fields into run summary.",
    "cli.py emits source_state_index_generated receipt.",
    "cli.py fails when local chain continuity is invalid."
  ]
}
