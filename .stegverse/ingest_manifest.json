{
  "schema": "stegverse_ingest_manifest.v1",
  "bundle_id": "core-lite-v0.7.1-wire-manifest-admissibility",
  "bundle_version": "0.7.1",
  "target_repo": "Data-Continuation/core-lite",
  "priority": "Critical",
  "bundle_family": "core-lite",
  "succession": {
    "mode": "versioning",
    "family": "core-lite"
  },
  "entrypoint": {
    "class": "master_records_endpoint_only",
    "source": "org_core_lite",
    "parent_event_hash": "sha256:bootstrap-local-core-lite-upgrade",
    "authority_confirmation": "local_core_lite_upgrade"
  },
  "requested_allow_scopes": [
    "ALLOW_QUEUE",
    "ALLOW_INSTALL"
  ],
  "purpose": "Wire manifest admissibility enforcement into core-lite ingestion before install action.",
  "install_policy": {
    "default_action": "overwrite_declared_files_only",
    "preserve_runtime_artifacts": true,
    "preserve_unlisted_files": true,
    "fail_on_unclassified_files": true
  },
  "files": [
    {
      "path": "core_lite/manifest.py",
      "class": "source",
      "action": "overwrite"
    },
    {
      "path": "core_lite/ingest.py",
      "class": "source",
      "action": "overwrite"
    },
    {
      "path": "docs/core-lite-v0.7.1-wire-manifest-admissibility.md",
      "class": "documentation",
      "action": "overwrite"
    },
    {
      "path": "iosnoperiod.md",
      "class": "documentation",
      "action": "overwrite"
    },
    {
      "path": ".stegverse/ingest_manifest.json",
      "class": "ingest_manifest",
      "action": "read_before_install"
    },
    {
      "path": "iosnoperiod/stegverse/ingest_manifest.json",
      "class": "iosnoperiod_mirror",
      "action": "overwrite"
    }
  ],
  "iosnoperiod_mappings": [
    {
      "canonical_path": ".stegverse/ingest_manifest.json",
      "iosnoperiod_path": "iosnoperiod/stegverse/ingest_manifest.json"
    }
  ],
  "generated_outputs": [
    ".stegverse/manifest_admissibility_report.json",
    "core_lite_queue_plan.json",
    "core_lite_ingest_report.json"
  ],
  "done_criteria": [
    "Manifest admissibility is called before install_declared_files.",
    "Failed admissibility prevents installation.",
    "manifest_admissibility_report.json is written.",
    "queue_planned receipt is emitted."
  ]
}
