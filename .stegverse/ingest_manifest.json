{
  "schema": "stegverse_ingest_manifest.v1",
  "bundle_id": "core-lite-empty-repo-install",
  "bundle_version": "0.9.0",
  "target_repo": "any",
  "target_engine_class": "org_core_lite",
  "install_mode": "empty_repo_bootstrap",
  "priority": "Critical",
  "bundle_family": "core-lite-empty-install",
  "succession": {
    "mode": "supersede",
    "family": "core-lite-empty-install"
  },
  "entrypoint": {
    "class": "user_entrypoint_and_master_records_endpoint",
    "source": "manual_upload"
  },
  "requested_allow_scopes": [
    "ALLOW_QUEUE",
    "ALLOW_INSTALL"
  ],
  "purpose": "Install a complete Core-Lite engine into an empty Org-level core-lite repository.",
  "install_policy": {
    "default_action": "overwrite_declared_files_only",
    "preserve_runtime_artifacts": true,
    "preserve_unlisted_files": true,
    "fail_on_unclassified_files": true
  },
