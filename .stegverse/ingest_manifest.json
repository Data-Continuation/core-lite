{
  "schema": "stegverse_ingest_manifest.v1",
  "bundle_id": "core-lite-v0.6-executable-ingestion-transitions",
  "bundle_version": "0.6.0",
  "target_repo": "Data-Continuation/core-lite",
  "priority": "Critical",
  "bundle_family": "core-lite",
  "succession": {
    "mode": "versioning",
    "family": "core-lite"
  },
  "purpose": "Add executable master hash event validation tied to ingestion transition IDs, hash identity types, and versioned validation rules.",
  "install_policy": {
    "default_action": "overwrite_declared_files_only",
    "preserve_runtime_artifacts": true,
    "preserve_unlisted_files": true,
    "fail_on_unclassified_files": true
  },
  "files": [
    {
      "path": "core_lite/master_hash_events.py",
      "class": "source",
      "action": "overwrite"
    },
    {
      "path": "schemas/master_hash_event.schema.json",
      "class": "schema",
      "action": "overwrite"
    },
    {
      "path": "schemas/hash_identity_types.json",
      "class": "schema_data",
      "action": "overwrite"
    },
    {
      "path": "schemas/validation_rules.json",
      "class": "schema_data",
      "action": "overwrite"
    },
    {
      "path": "docs/core-lite-v0.6-executable-ingestion-transitions.md",
      "class": "documentation",
      "action": "overwrite"
    },
    {
      "path": "iosnoperiod.md",
      "class": "documentation",
      "action": "overwrite"
    },
    {
      "path": ".stegverse/ingest_manifest.json",
      "class": "ingest_manifest",
      "action": "read_before_install"
    },
    {
      "path": "iosnoperiod/stegverse/ingest_manifest.json",
      "class": "iosnoperiod_mirror",
      "action": "overwrite"
    }
  ],
  "iosnoperiod_mappings": [
    {
      "canonical_path": ".stegverse/ingest_manifest.json",
      "iosnoperiod_path": "iosnoperiod/stegverse/ingest_manifest.json"
    }
  ],
  "generated_outputs": [
    ".stegverse/master_hash_records.jsonl",
    ".stegverse/master_hash_validation_report.json"
  ],
  "done_criteria": [
    "Hash identity types are defined.",
    "Versioned validation rules are defined.",
    "Master hash event schema is defined.",
    "master_hash_events.py validates events against transition_id requirements.",
    "SDK and sandbox source-known entrypoint handling is represented in validation rules."
  ]
}
